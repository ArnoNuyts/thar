{
  "name": "todotui",
  "version": "0.5.0",
  "description": "A keyboard-driven todo.txt TUI for the terminal",
  "keywords": [
    "cli",
    "ink",
    "productivity",
    "react",
    "terminal",
    "todo",
    "todo.txt",
    "tui"
  ],
  "homepage": "https://github.com/ArnoNuyts/todotui#readme",
  "bugs": {
    "url": "https://github.com/ArnoNuyts/todotui/issues"
  },
  "license": "MIT",
  "author": "Arno Nuyts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ArnoNuyts/todotui.git"
  },
  "bin": {
    "todotui": "./bin/todotui.js"
  },
  "files": [
    "bin",
    "dist/*.js",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "start": "vite-node main.tsx",
    "dev": "vite-node main.tsx",
    "build": "vite build",
    "build:sea": "node scripts/build-sea.mjs",
    "prepack": "npm run build",
    "prepublishOnly": "npm run check && npm test",
    "package:check": "npm pack --dry-run",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint .",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "check": "npm run typecheck && npm run lint && npm run fmt:check",
    "doctor": "react-doctor ."
  },
  "dependencies": {
    "chalk": "^6.0.1",
    "date-fns": "^4.4.0",
    "ink": "^8.0.0",
    "react": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "ink-testing-library": "^4.0.0",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "react-doctor": "^0.9.18",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-node": "^6.0.0",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "npm@11.20.0"
}
