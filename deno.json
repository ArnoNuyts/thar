{
  "tasks": {
    "start": "deno run --allow-sys --allow-env --allow-ffi --allow-read --allow-write main.tsx",
    "fmt": "deno fmt",
    "test": "deno test -A --parallel",
    "test:serial": "deno test -A",
    "hooks": "deno run -A deno-hooks"
  },
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@^1.0.16",
    "ink": "npm:ink@^8.0.0",
    "react": "npm:react@^19.3.0",
    "react/jsx-runtime": "npm:react@^19.3.0/jsx-runtime",
    "chalk": "npm:chalk@^5.0.0",
    "@std/async": "jsr:@std/async@1.0.14",
    "date-fns": "npm:date-fns@^4.1.0",
    "@types/react": "npm:@types/react@^19.3.0",
    "ink-testing-library": "npm:ink-testing-library@^4.0.0",
    "deno-hooks": "jsr:@theswanfactory/deno-hooks@^0.3.0"
  },
  "deno-hooks": {
    "pre-commit": [
      "deno task fmt",
      "deno lint"
    ],
    "pre-push": [
      "deno task test"
    ]
  }
}
