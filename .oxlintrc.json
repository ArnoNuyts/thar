{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "ignorePatterns": ["dist/**", "node_modules/**"],
  "jsPlugins": ["./scripts/oxlint-plugin.mjs"],
  "plugins": [
    "eslint",
    "typescript",
    "unicorn",
    "oxc",
    "react",
    "react-perf",
    "jsx-a11y"
  ],
  "rules": {
    "eslint/no-control-regex": "off",
    "eslint/no-unused-vars": [
      "warn",
      {
        "argsIgnorePattern": "^_",
        "caughtErrorsIgnorePattern": "^_"
      }
    ],
    "unicorn/no-useless-spread": "off",
    "thar/no-native-date-math": "error",
    // The date-fns barrel loads every helper plus each helper's default
    // locale, which costs ~1.5s of module loading at startup; import the used
    // helpers from their own subpaths instead.
    "eslint/no-restricted-imports": [
      "error",
      {
        "paths": [
          {
            "name": "date-fns",
            "message": "Import from \"date-fns/<fn>\" (e.g. \"date-fns/addDays\") instead of the date-fns barrel."
          }
        ],
        "patterns": [
          {
            "group": ["date-fns/locale", "date-fns/fp"],
            "message": "Import the specific module (e.g. \"date-fns/locale/en-US\") instead of the barrel."
          }
        ]
      }
    ]
  },
  "overrides": [
    {
      // Test components capture values in outer variables and deliberately
      // omit effect dependencies; those idioms are not React bugs in tests.
      "files": ["unit-tests/**"],
      "rules": {
        "react/globals": "off",
        "react/immutability": "off",
        "react-hooks/exhaustive-deps": "off"
      }
    }
  ]
}
