{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "ignorePatterns": ["dist/**", "node_modules/**"],
  "jsPlugins": ["./scripts/oxlint-plugin.mjs"],
  "plugins": [
    "eslint",
    "typescript",
    "unicorn",
    "oxc",
    "react",
    "react-perf",
    "jsx-a11y"
  ],
  "rules": {
    "eslint/no-control-regex": "off",
    "eslint/no-unused-vars": [
      "warn",
      {
        "argsIgnorePattern": "^_",
        "caughtErrorsIgnorePattern": "^_"
      }
    ],
    "unicorn/no-useless-spread": "off",
    "thar/no-native-date-math": "error"
  },
  "overrides": [
    {
      // Test components capture values in outer variables and deliberately
      // omit effect dependencies; those idioms are not React bugs in tests.
      "files": ["unit-tests/**"],
      "rules": {
        "react/globals": "off",
        "react/immutability": "off",
        "react-hooks/exhaustive-deps": "off"
      }
    }
  ]
}
